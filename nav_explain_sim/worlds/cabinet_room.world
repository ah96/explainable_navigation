<?xml version="1.0"?>
<!-- Minimal Gazebo Classic world sketch for the semantic scenario "cabinet_room".
     Written for ROS 2 Humble and not ported to the Gazebo of ROS 2 Lyrical (see
     "Simulation assets" in TUTORIAL.md). The object geometry is defined by
     nav_explain_semantic/data/scenarios/cabinet_room/ontology.csv. This world
     places matching primitives so that a simulated robot can drive among them. -->
<sdf version="1.6">
  <world name="cabinet_room">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="cabinet">
      <static>true</static>
      <pose>4.156 0.431 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.96 0.54 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.96 0.54 0.8</size></box></geometry></visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>4.096 2.491 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.46 0.82 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.46 0.82 0.8</size></box></geometry></visual>
      </link>
    </model>

    <model name="door">
      <static>true</static>
      <pose>7.471 -0.377 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 1.125 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.125 1.0</size></box></geometry></visual>
      </link>
    </model>
    <!-- Walls and the chair are omitted for brevity; add from ontology.csv as needed. -->
  </world>
</sdf>
