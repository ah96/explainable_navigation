<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_explain_semantic</name>
  <version>0.1.0</version>
  <description>Visuo-textual explanations (LIME over a semantic map + QSR +
    ontology) of a robot's navigational choices. Depends on nav_explain_core.</description>
  <maintainer email="amar.halilovic@uni-ulm.de">Amar Halilovic</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>nav_explain_core</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
