<?xml version="1.0"?>
<!-- Minimal Gazebo Classic world matching scenario C1: a doorway between two
     walls. Optional full-sim asset (not needed for the headless reproduction). -->
<sdf version="1.6">
  <world name="doorway">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="left_wall">
      <static>true</static>
      <pose>-0.7 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 2.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 2.0 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="right_wall">
      <static>true</static>
      <pose>0.7 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 2.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 2.0 1.0</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
